
{% extends 'base.html.twig' %}

{% block title %}Manage Projects | Admin{% endblock %}

{% block body %}
    <main class="admin-page">
        <header class="admin-header">
            <div>
                <p class="admin-eyebrow">PORTFOLIO ADMINISTRATION</p>
                <h1>Manage Projects</h1>
                <p class="admin-description">
                    Manage your portfolio projects and their visibility.
                </p>
            </div>

            <a href="{{ path('admin_project_new') }}" class="admin-add-btn">
                + Add project
            </a>
        </header>

        <section class="admin-panel">
            <div class="admin-panel-header">
                <h2>All Projects</h2>
                <span>{{ projects|length }} total</span>
            </div>

            <div class="admin-table-wrapper">
                <table class="admin-table">
                    <thead>
                    <tr>
                        <th>Project</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                    </thead>

                    <tbody>
                    {% for project in projects %}
                        <tr>
                            <td>
                                <strong>{{ project.name }}</strong>
                                <p>{{ project.description }}</p>
                            </td>

                            <td>
                                    <span class="admin-status {{ project.published ? 'is-published' : 'is-draft' }}">
                                        {{ project.published ? 'Published' : 'Draft' }}
                                    </span>
                            </td>

                            <td>
                                <div class="admin-actions">
                                    <a href="{{ path('admin_project_edit', {id: project.id}) }}">
                                        Edit
                                    </a>

                                    <a class="admin-delete"
                                       href="{{ path('admin_project_delete', {id: project.id}) }}">
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="3">
                                No projects yet. Add your first project.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    </main>
{% endblock %}
