
{% extends 'base.html.twig' %}

{% block title %}Mantas | PHP Developer{% endblock %}

{% block body %}
    <main>
        <h1>Hi, I'm Mantas 👋</h1>

        <h2>PHP & Symfony Backend Developer</h2>

        <p>
            I'm a junior PHP developer with
            one year of professional experience.
        </p>

        <h3>My Tech Stack</h3>

        <ul>
            {% for skill in skills %}
                <li>{{ skill }}</li>
            {% endfor %}
        </ul>
        <section class="projects">
            <h2>Projects</h2>

            <div class="project-grid">
                {% for project in projects %}
                    <article class="project-card">
                        <h3>{{ project.name }}</h3>
                        <p>{{ project.description }}</p>
                        <a href="{{ project.url }}">View {{ project.name }} on GitHub</a>
                    </article>
                {% endfor %}
            </div>
        </section>
    </main>
{% endblock %}
